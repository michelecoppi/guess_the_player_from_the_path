# Token del bot Telegram (da @BotFather)
BOT_TOKEN=

# Percorso locale del file JSON del service account Firebase
FIREBASE_CREDENTIALS_PATH=firebase-key.json

# URL pubblico che Telegram usa per il webhook (es. https://tuo-bot.onrender.com/webhook)
WEBHOOK_URL=

# ID Telegram (numerici) abilitati ai comandi /admin_*, separati da virgola
ADMIN_TELEGRAM_IDS=

# Porta su cui gira il server (impostata automaticamente da Render/Railway)
PORT=8000
